// Run inside the container: iris session IRIS -U USER < load-code.script
zn "PATREG"
set sc = $SYSTEM.OBJ.LoadDir("/home/irisowner/dev/src", "ck", .errors, 1)
if $SYSTEM.Status.IsError(sc) {do $SYSTEM.Status.DisplayError(sc)}
set sc = ##class(PatientRegistry.Setup.Installer).GrantSqlPrivileges("PATREG")
if $SYSTEM.Status.IsError(sc) { do $SYSTEM.Status.DisplayError(sc)}
halt

