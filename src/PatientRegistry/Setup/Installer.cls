Class PatientRegistry.Setup.Installer
{
    XData Install [XMLNamespace = INSTALLER]
    {
        <Manifest>
            <Default Name="NAMESPACE" Value="PATREG"/>
            <Default Name="DBNAME" Value="${NAMESPACE}DB"/>
            <Default Name="DBDIR" Value="${MGRDIR}${DBNAME}"/>
            <Namespace Name="${NAMESPACE}" Code="${DBNAME}" Data="${DBNAME}" Create="yes" Ensemble="0">
                <Configuration>
                    <Database Name="${DBNAME}" Dir="${DBDIR}" Create="yes" Resource="%DB_${DBNAME}"/>
                </Configuration>
            </Namespace>
        </Manifest>
    }

    /// Creates the namespace unless it already exists. Returns a %Status.
    ClassMethod Run(pNamespace AS %String = "PATREG") As %Status
    {
        Set sc = $$$OK
        Try {
            If ##class(%SYS.Namespace).Exists(pNamespace) {
                Write "Namespace ", pNamespace, " already exists - nothing to do.", !
            } Else {
                Set vars("NAMESPACE") = pNamespace
                $$$ThrowOnError(..setup(.vars))
                Write "Namespace ", pNamespace, " created.", !
            }
            $$$ThrowOnError(..UnexpireDevPasswords())
        } Catch ex {
            Set sc = ex.AsStatus()
        }
        Quit sc
    }

    /// DEV ONLY. Stops IRIS forcing a password change at first login so the VS Code extension can connect.
    ClassMethod UnexpireDevPasswords() As %Status
    {
        New $NAMESPACE
        Set $NAMESPACE = "%SYS"
        Quit ##class(Security.Users).UnExpireUserPasswords("*")
    }

    /// Creates the application role (database access only) and user. The password is read from a mount secret file.
    ClassMethod CreateApplicationAccess(pNamespace As %String = "PATREG", pPasswordFile As %String = "/run/secrets/iris_app_password") As %Status
    {
        Set sc = $$$OK
        Try {
            if pNamespace '? 1.20(1U,1N) {
                $$$ThrowStatus($$$ERROR($$$GeneralError, "namespace must be upper-case letters and digits"))
            }
            Set role = pNamespace_"_APP"
            Set user = $ZCONVERT(pNamespace, "L")_"_svc"
            Set stream = ##class(%Stream.FileCharacter).%New()
            $$$ThrowOnError(stream.LinkToFile(pPasswordFile))
            Set password = $ZSTRIP(stream.Read(200), "<>W")
            if password = "" {
                $$$ThrowStatus($$$ERROR($$$GeneralError, "application password file is empty"))
            }
            New $NAMESPACE
            Set $NAMESPACE = "%SYS"
            if '##class(Security.Roles).Exists(role){
                $$$ThrowOnError(##class(Security.Roles).Create(role, "Application role for "_pNamespace, "%DB_"_pNamespace_"DB:RW"))
            }
            if '##class(Security.Users).Exists(user){
                $$$ThrowOnError(##class(Security.Users).Create(user, role, password, "Application account for "_pNamespace, pNamespace))
            }
        } Catch ex {
            set sc = ex.AsStatus()
        }
        Quit sc
    }

    /// Grants the application role the SQL privileges it needs on the Patient table. Run after the code is compiled.
    ClassMethod GrantSqlPrivileges(pNamespace As %String = "PATREG") As %Status
    {
        Set sc = $$$OK
        Try {
            if pNamespace '? 1.20(1U,1N){
                $$$ThrowStatus($$$ERROR($$$GeneralError, "namespace must be upper-case letters and digits"))
            }
            New $NAMESPACE
            Set $NAMESPACE = pNamespace
            Set stmt = ##class(%SQL.Statement).%New()
            $$$ThrowOnError(stmt.%Prepare("GRANT SELECT, INSERT, UPDATE, DELETE ON PatientRegistry_Model.Patient TO "_pNamespace_"_APP"))
            Set rs = stmt.%Execute()
            If rs.%SQLCODE < 0 {
                Throw ##class(%Exception.SQL).CreateFromSQLCODE(rs.%SQLCODE, rs.%Message)
            }
        } Catch ex {
            Set sc = ex.AsStatus()
        }
        Quit sc
    }

    /// Generated by the %Installer framework from the XData block above.
    ClassMethod setup(ByRef pVars, pLogLevel AS %Integer = 3, pInstaller As %Installer.Installer, pLogger As %Installer.AbstractLogger) As %Status [CodeMode = objectgenerator, Internal]
    {
        Quit ##class(%Installer.Manifest).%Generate(%compiledclass, %code, "Install")
    }
}
