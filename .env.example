# Copy to .env (git-ignored) and adjust. Contains NO secrets.
# ICR community images are public. A tag such as 2025.3 can be re-pushed with a
# newer maintenance build — see "Pin the image" in Step 3.
# 2025.3 failed at startup (--password-file: /usr/irissys/bin/CSPpwd missing); 2025.3 works.
IRIS_IMAGE=containers.intersystems.com/intersystems/iris-community:2025.3
IRIS_SUPERSERVER_PORT=41972
IRIS_WEB_PORT=42773