# Copy to .env (git-ignored) and adjust. Contains NO secrets.
# ICR community images are public. EM tags (e.g. 2025.1) float to the latest
# maintenance release — see "Pin the image" in Step 3.
IRIS_IMAGE=containers.intersystems.com/intersystems/iris-community:2026.2
IRIS_SUPERSERVER_PORT=41972
IRIS_WEB_PORT=42773